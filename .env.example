# Database Configuration (PostgreSQL default, SQLite fallback supported: sqlite:///./appearance_intelligence.db)
DATABASE_URL=sqlite:///./appearance_intelligence.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/appearance_db

# Message Broker / Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Worker mode: "async_task" (in-process for lightweight/local execution) or "celery"
WORKER_MODE=async_task

# LLM Providers (Groq recommended for free/fast inference, or OpenAI)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

EXA_API_KEY=your_exa_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
YOUTUBE_API_KEY=your_youtube_api_key_here

# Optional API Auth Token for protecting enrichment endpoints
# API_AUTH_TOKEN=your_secret_bearer_token_here

# App Environment & Logging
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME="Public Appearance Intelligence System"
API_V1_PREFIX=/api/v1

